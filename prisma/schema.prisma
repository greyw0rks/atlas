generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// MemoryKind — stored as a plain String on SQLite (Prisma has no enum on SQLite).
// Allowed values (keep in sync with lib/memory/kinds.ts):
//   ARCHITECTURE | DECISION | BUG | TODO | WARNING |
//   IMPORTANT_FILE | DEPENDENCY | SECURITY | CONTEXT

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATIONAL MEMORY — knowledge shared across repositories
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  // Engineering standards / conventions all agents in this org must follow
  standards String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  repos Repository[]
}

// ─────────────────────────────────────────────────────────────────────────────
// REPOSITORY MEMORY — what an agent needs to know about a specific repo
// ─────────────────────────────────────────────────────────────────────────────

model Repository {
  id        String    @id @default(cuid())
  // Canonical identifier: absolute path or "github.com/org/repo"
  path      String    @unique
  name      String
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  context   RepositoryContext?
  sessions  CodingSession[]
  memories  Memory[]
  decisions Decision[]
}

model RepositoryContext {
  id             String     @id @default(cuid())
  repoId         String     @unique
  repo           Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  // JSON-encoded string[] (SQLite has no scalar lists). Parse via lib/memory/kinds.ts.
  techStack      String     @default("[]")
  importantFiles String     @default("[]")
  architecture   String?    // markdown: how the system is structured
  constraints    String?    // hard rules / "don't touch" notes

  // Cached count of unresolved TODO + BUG memories — avoids a full scan on load
  openTaskCount  Int        @default(0)

  // Deterministic summary built from the structured fields above.
  // Semantic recall now lives in Walrus Memory (MemWal), not a local vector column.
  contextText    String?

  sessionCount  Int       @default(0)
  lastSessionAt DateTime?
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION MEMORY — what happened during one coding session
// ─────────────────────────────────────────────────────────────────────────────

model CodingSession {
  id          String     @id @default(cuid())
  repoId      String
  repo        Repository @relation(fields: [repoId], references: [id])
  // "claude-code" | "codex" | "cursor" | "gemini-cli" | etc.
  agentId     String
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  durationMs  Int?
  summary     String?    // short human-readable summary of what happened
  // Full structured handoff (WHAT I DID / WHAT FAILED / NEXT) written by
  // atlas_create_handoff and projected to .atlas/sessions/<date>.md
  handoffText String?
  completed   Boolean    @default(false)

  memories  Memory[]
  decisions Decision[]

  @@index([repoId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMORY UNITS — individual facts an agent learned or noted
// ─────────────────────────────────────────────────────────────────────────────

model Memory {
  id         String        @id @default(cuid())
  sessionId  String
  session    CodingSession @relation(fields: [sessionId], references: [id])
  repoId     String
  repo       Repository    @relation(fields: [repoId], references: [id])

  kind       String        // see MemoryKind values above
  content    String        // the fact / note
  // 1 = low-signal, 5 = critical.
  importance Int           @default(1)
  // JSON-encoded string[] (SQLite has no scalar lists).
  tags       String        @default("[]")
  // TODOs and BUGs can be marked resolved without deletion, preserving history.
  resolved   Boolean       @default(false)

  // Walrus Memory (MemWal) is the system-of-record for the memory text on Mainnet.
  // blobId = the Walrus blob id returned by rememberAndWait (onchain proof / link).
  // namespace = the MemWal namespace the memory was written under (= repo name).
  blobId     String?
  namespace  String?
  // JSON provenance from Tatum's Sui RPC for any object ids / tx digests named in
  // the memory (ChainVerification in lib/chain/tatum.ts). null = nothing to check
  // or Tatum not configured; it is never a claim that a check passed.
  chainVerification String?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([repoId, kind])
  @@index([repoId, resolved])
}

model Decision {
  id           String        @id @default(cuid())
  sessionId    String
  session      CodingSession @relation(fields: [sessionId], references: [id])
  repoId       String
  repo         Repository    @relation(fields: [repoId], references: [id])

  title        String    // short label: "Use Fastify over Express"
  rationale    String    // why this choice was made
  // JSON-encoded string[] (SQLite has no scalar lists).
  alternatives String    @default("[]")

  // Mirrored to Walrus Memory as well; blobId = onchain proof for the decision.
  blobId       String?
  // Tatum-verified provenance for Sui references in the decision text.
  chainVerification String?

  createdAt    DateTime  @default(now())

  @@index([repoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT — log of every memory retrieval for observability / debugging
// ─────────────────────────────────────────────────────────────────────────────

model MemoryRetrieval {
  id        String   @id @default(cuid())
  // "knn" | "tasks" | "sessions" | "context" | "decisions" | "search"
  kind      String
  queryText String
  repoId    String?
  // JSON-encoded string[] / number[] (SQLite has no scalar lists).
  hitIds    String   @default("[]")
  scores    String   @default("[]")
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([repoId, createdAt])
}
