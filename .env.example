# Postgres. Local dev: docker run --name atlas-pg -e POSTGRES_PASSWORD=atlas \
#   -e POSTGRES_DB=atlas -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:atlas@localhost:5432/atlas?schema=public"

# OPTIONAL. Atlas runs fully on keyless Blockscout; this only adds a faster path.
# Note: the Alchemy adapter cannot decode event logs, so bridge matching falls
# back to heuristics when it is used.
ALCHEMY_API_KEY=

# OPTIONAL. Supplements coverage on Ethereum/Arbitrum/Polygon/Celo only —
# the free tier dropped Base and Optimism in Nov 2025.
ETHERSCAN_API_KEY=
