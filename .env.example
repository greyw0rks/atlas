# ─────────────────────────────────────────────────────────────────────────────
# Atlas — Total Recall (Walrus x Tatum). Copy to .env and fill in real values.
# .env is gitignored; this example file is safe to commit (no secrets).
# ─────────────────────────────────────────────────────────────────────────────

# Local SQLite index (dashboard timeline / sessions / decisions).
DATABASE_URL="file:./dev.db"

# ─── Walrus Memory (MemWal) — the memory system-of-record on mainnet ──────────
# From the MemWal dashboard → Delegate keys (https://memory.walrus.xyz/dashboard)
MEMWAL_PRIVATE_KEY="<delegate private key, hex — keep secret>"
# The on-chain MemWalAccount OBJECT id (0x + 64 hex), NOT the delegate public key.
# Passing the public key here makes the relayer reject every request with HTTP 401.
# The object id is the `account_id` field on the account::DelegateKeyAdded event
# emitted when the delegate key was registered.
MEMWAL_ACCOUNT_ID="0x<memwal account object id>"
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"
MEMWAL_NETWORK="mainnet"

# ─── Tatum (Sui RPC — onchain verification of memories) ──────────────────────
# Optional. When set, it is sent as x-api-key (recommended for rate limits).
# The gateway also answers keyless requests today, so verification works either
# way; any rejection is recorded on the memory instead of being hidden.
TATUM_API_KEY=""
TATUM_SUI_RPC_URL="https://sui-mainnet.gateway.tatum.io"
TATUM_SUI_NETWORK="sui-mainnet"
