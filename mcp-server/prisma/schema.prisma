generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum MemoryKind {
  ARCHITECTURE   // how the system is structured
  DECISION       // a choice that was made
  BUG            // a known issue
  TODO           // unfinished work
  WARNING        // don't touch / tread carefully
  IMPORTANT_FILE // a file that matters disproportionately
  DEPENDENCY     // key external dep or integration
  SECURITY       // security consideration
  CONTEXT        // general background context
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATIONAL MEMORY — knowledge shared across repositories
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  // Engineering standards / conventions all agents in this org must follow
  standards String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  repos Repository[]
}

// ─────────────────────────────────────────────────────────────────────────────
// REPOSITORY MEMORY — what an agent needs to know about a specific repo
// ─────────────────────────────────────────────────────────────────────────────

model Repository {
  id        String    @id @default(cuid())
  // Canonical identifier: absolute path or "github.com/org/repo"
  path      String    @unique
  name      String
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  context   RepositoryContext?
  sessions  CodingSession[]
  memories  Memory[]
  decisions Decision[]
}

model RepositoryContext {
  id             String     @id @default(cuid())
  repoId         String     @unique
  repo           Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  techStack      String[]   @default([])
  importantFiles String[]   @default([])
  architecture   String?    // markdown: how the system is structured
  constraints    String?    // hard rules / "don't touch" notes

  // Cached count of unresolved TODO + BUG memories — avoids a full scan on load
  openTaskCount  Int        @default(0)

  // Deterministic summary built from the structured fields above.
  // Written as a stable string so re-embedding produces an identical vector.
  // Never LLM-generated — that would make semantic neighbourhoods drift.
  contextText      String?
  // Written via $executeRaw with ::vector cast (Prisma has no native vector type)
  contextEmbedding Unsupported("VECTOR(1024)")?
  embeddedAt       DateTime?

  sessionCount  Int       @default(0)
  lastSessionAt DateTime?
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION MEMORY — what happened during one coding session
// ─────────────────────────────────────────────────────────────────────────────

model CodingSession {
  id          String     @id @default(cuid())
  repoId      String
  repo        Repository @relation(fields: [repoId], references: [id])
  // "claude-code" | "codex" | "cursor" | "gemini-cli" | etc.
  agentId     String
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  durationMs  Int?
  summary     String?    // short human-readable summary of what happened
  // Full structured handoff (WHAT I DID / WHAT FAILED / NEXT) written by
  // atlas_create_handoff and projected to .atlas/sessions/<date>.md
  handoffText String?
  completed   Boolean    @default(false)

  memories  Memory[]
  decisions Decision[]

  @@index([repoId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMORY UNITS — individual facts an agent learned or noted
// ─────────────────────────────────────────────────────────────────────────────

model Memory {
  id         String        @id @default(cuid())
  sessionId  String
  session    CodingSession @relation(fields: [sessionId], references: [id])
  repoId     String
  repo       Repository    @relation(fields: [repoId], references: [id])

  kind       MemoryKind
  content    String        // the fact / note
  // 1 = low-signal, 5 = critical. Embedding gate: importance >= 3.
  importance Int           @default(1)
  tags       String[]      @default([])
  // TODOs and BUGs can be marked resolved without deletion, preserving history.
  resolved   Boolean       @default(false)

  // Written via $executeRaw with ::vector cast
  embedding  Unsupported("VECTOR(1024)")?
  embeddedAt DateTime?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([repoId, kind])
  @@index([repoId, resolved])
}

model Decision {
  id           String        @id @default(cuid())
  sessionId    String
  session      CodingSession @relation(fields: [sessionId], references: [id])
  repoId       String
  repo         Repository    @relation(fields: [repoId], references: [id])

  title        String    // short label: "Use Fastify over Express"
  rationale    String    // why this choice was made
  alternatives String[]  @default([]) // what else was considered

  createdAt    DateTime  @default(now())

  @@index([repoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT — log of every memory retrieval for observability / debugging
// ─────────────────────────────────────────────────────────────────────────────

model MemoryRetrieval {
  id        String   @id @default(cuid())
  // "knn" | "tasks" | "sessions" | "context" | "decisions" | "search"
  kind      String
  queryText String
  repoId    String?
  hitIds    String[]
  scores    Float[]
  latencyMs Int
  createdAt DateTime @default(now())

  @@index([repoId, createdAt])
}

